<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>AuditAssistant.AI</AssemblyName>
    <RootNamespace>AuditAssistant.AI</RootNamespace>
    <Description>AI services using Semantic Kernel for embeddings and audit analysis with OpenAI/Azure OpenAI</Description>
    
    <!-- Library Configuration -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageTags>ai;semantic-kernel;openai;azure-openai;embeddings;rag</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.7.0-beta.2" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.68.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuditAssistant.Core\AuditAssistant.Core.csproj" />
  </ItemGroup>

</Project>
