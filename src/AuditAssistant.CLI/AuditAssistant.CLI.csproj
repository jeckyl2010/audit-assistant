<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>AuditAssistant.CLI</AssemblyName>
    <RootNamespace>AuditAssistant.CLI</RootNamespace>
    <Description>AI-powered audit assistant CLI with RAG architecture</Description>
    
    <!-- Runtime Configuration -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    
    <!-- Enable Trimming for smaller executables -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuditAssistant.Core\AuditAssistant.Core.csproj" />
    <ProjectReference Include="..\AuditAssistant.AI\AuditAssistant.AI.csproj" />
    <ProjectReference Include="..\AuditAssistant.Data\AuditAssistant.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
