<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>AuditAssistant.Core</AssemblyName>
    <RootNamespace>AuditAssistant.Core</RootNamespace>
    <Description>Core domain models, interfaces, and services for audit document processing with token-aware chunking</Description>
    
    <!-- Library Configuration -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageTags>audit;compliance;rag;semantic-chunking;tiktoken</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.44.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="TiktokenSharp" Version="1.2.0" />
  </ItemGroup>

</Project>
